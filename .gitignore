```gitignore
# Compiled and binary files
*.pyc
__pycache__/

# Dependencies
venv/
.venv/
node_modules/
*.egg-info/
dist/
build/
target/
.gradle/

# Environment files
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Python specific
*.pyo
*.pyd
.Python
*.so
*.egg

# Cache directories
.mypy_cache/
.pytest_cache/
.hypothesis/
```